# Copy to .env and set both passwords to independent random values before use.
# Generate each with: openssl rand -hex 32
MONGO_INITDB_ROOT_USERNAME=mawee_root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=mawee
MAWEE_APP_USERNAME=mawee_app
MAWEE_APP_PASSWORD=

# Configure the app's MONGODB_URI GitHub secret using the connection details
# documented in README.md and the app password above.
