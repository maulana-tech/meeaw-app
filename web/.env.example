# Monad testnet. `pnpm --filter contracts deploy:testnet` fills in the
# contract addresses below automatically (it writes web/.env.local).
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MAWEE_REGISTRY_ADDRESS=
NEXT_PUBLIC_MAWEE_POOL_ADDRESS=
NEXT_PUBLIC_MAWEE_POOL_DEPLOY_BLOCK=0
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_USDC_DECIMALS=6
NEXT_PUBLIC_USDC_MINTABLE=false
NEXT_PUBLIC_POOL_DEPTH=20

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

MONGODB_URI=mongodb://localhost:27017/mawee
CRON_SECRET=replace-with-a-long-random-secret
MONAD_LOGS_BLOCK_RANGE=100

# Gasless mode: this hot wallet submits users' signed/proved transactions and
# pays the MON gas. Fund it from https://faucet.monad.xyz and keep the balance
# small. Leave empty to make users pay their own gas.
RELAYER_PRIVATE_KEY=
# Optional dedicated RPC for the relayer, e.g. Alchemy:
# https://monad-testnet.g.alchemy.com/v2/<your-key>
RELAYER_RPC_URL=

# Envio HyperIndex GraphQL endpoint (see indexer/). When set, wallet scanning
# and pool stats come from Envio instead of the eth_getLogs poller.
ENVIO_GRAPHQL_URL=
