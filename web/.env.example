# Monad testnet. `pnpm --filter contracts deploy:testnet` fills in the
# contract addresses below automatically (it writes web/.env.local).
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MAWEE_REGISTRY_ADDRESS=
NEXT_PUBLIC_MAWEE_POOL_ADDRESS=
NEXT_PUBLIC_MAWEE_POOL_DEPLOY_BLOCK=0
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_USDC_DECIMALS=6
NEXT_PUBLIC_USDC_MINTABLE=false
NEXT_PUBLIC_POOL_DEPTH=20
# Optional pool manifest: one "active" pool (deposits, payment requests) plus
# "legacy" pools that stay withdrawable. Public addresses only. Example:
# [{"chainId":10143,"address":"0x…","deployBlock":0,"token":"0x…","tokenDecimals":6,
#   "depth":20,"confirmations":1,"role":"active","requestCapable":true}]
# Unset: the single pool above is used and cannot take payment requests.
NEXT_PUBLIC_MAWEE_POOLS=

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

MONGODB_URI=mongodb://localhost:27017/mawee
CRON_SECRET=replace-with-a-long-random-secret
MONAD_LOGS_BLOCK_RANGE=100

# Gasless mode: this hot wallet submits users' signed/proved transactions and
# pays the MON gas. Fund it from https://faucet.monad.xyz and keep the balance
# small. Leave empty to make users pay their own gas.
RELAYER_PRIVATE_KEY=
# Optional local contract deployment only. Keep this dedicated testnet wallet
# separate from the relayer; consumed by agora:preflight/agora:deploy:testnet.
DEPLOYER_PRIVATE_KEY=
## Sponsorship examples; tune to measured gas costs before activation.
## Required budget/fee fields missing or invalid pause new sponsored actions.
RELAYER_USER_ACTIONS_PER_DAY=20
RELAYER_GUEST_ACTIONS_PER_DAY=20
RELAYER_ANONYMOUS_ACTIONS_PER_DAY=100
RELAYER_DAILY_BUDGET_MON=5
RELAYER_ANONYMOUS_BUDGET_MON=1
RELAYER_ACTION_BUDGET_MON=0.5
RELAYER_BALANCE_FLOOR_MON=0.1
RELAYER_MAX_FEE_GWEI=200
RELAYER_MAX_ACTION_STEPS=16
# Optional dedicated RPC for the relayer, e.g. Alchemy:
# https://monad-testnet.g.alchemy.com/v2/<your-key>
RELAYER_RPC_URL=

# Envio HyperIndex GraphQL endpoint (see indexer/). When set, wallet scanning
# and pool stats come from Envio instead of the eth_getLogs poller.
ENVIO_GRAPHQL_URL=
