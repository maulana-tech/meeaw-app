# Monad testnet. `pnpm --filter contracts deploy:testnet` fills in the
# contract addresses below automatically (it writes web/.env.local).
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MAWEE_REGISTRY_ADDRESS=
NEXT_PUBLIC_MAWEE_POOL_ADDRESS=
NEXT_PUBLIC_MAWEE_POOL_DEPLOY_BLOCK=0
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_USDC_DECIMALS=6
NEXT_PUBLIC_USDC_MINTABLE=false
NEXT_PUBLIC_POOL_DEPTH=20

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

MONGODB_URI=mongodb://localhost:27017/mawee
CRON_SECRET=replace-with-a-long-random-secret
MONAD_LOGS_BLOCK_RANGE=100
