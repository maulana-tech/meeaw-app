{
  "name": "mawee",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "contract:build": "pnpm --filter contracts build",
    "contract:test": "pnpm --filter contracts test",
    "deploy:testnet": "pnpm --filter contracts deploy:testnet"
  },
  "workspaces": [
    "web",
    "contracts"
  ],
  "dependencies": {
    "@fontsource/aileron": "^5.2.5"
  },
  "pnpm": {
    "overrides": {
      "viem": "2.52.0"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        }
      }
    }
  }
}
